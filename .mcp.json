{
  "mcpServers": {
    "ask-jev": {
      "command": "node",
      "args": ["./mcp/dist/index.js"],
      "cwd": ".",
      "env_vars": [
        "JEV_BASE_URL",
        "JEV_API_KEY",
        "JEV_MODEL",
        "JEV_TIMEOUT_MS",
        "JEV_MAX_RETRIES",
        "TYPESAFE_BASE_URL",
        "TYPESAFE_API_KEY",
        "TYPESAFE_MODEL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY"
      ]
    }
  }
}
